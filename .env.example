# Copy to .env and fill in. .env is gitignored.
GROQ_API_KEY=

# The model every agent uses unless overridden below.
# Must support tool calling — that is what the router's structured output uses.
# Groq retires model ids periodically, so list what your key can reach:
#   uv run python -c "import groq,dotenv;dotenv.load_dotenv();print([m.id for m in groq.Groq().models.list().data])"
GROQ_MODEL=qwen/qwen3.8-27b

# Optional per-agent overrides. Each falls back to GROQ_MODEL when unset.
# Run /models inside the app to see what is actually in effect.

# One 3-way classification, on EVERY turn. Highest-volume call in the app and the
# easiest task, so this is where a smaller, cheaper model pays off most.
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# Reads a dense numeric report without inventing values. The hardest job here, and
# the one that most rewards a larger model.
# GROQ_SUMMARIZER_MODEL=openai/gpt-oss-120b

# A formatter: every fact comes from the interview, so it needs instruction-following
# and restraint rather than knowledge.
# GROQ_REPORT_MODEL= openai/gpt-oss-20b)

# Open-ended health questions. Wants breadth of knowledge and readable prose.
# GROQ_QA_MODEL=openai/gpt-oss-120b
